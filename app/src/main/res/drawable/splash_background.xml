<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash Screen background drawable.
    Fondo oscuro con el logo oficial de StockCalzadoApp centrado.
    Se aplica como windowBackground en Theme.StockCalzadoApp.Splash.
    No añade ningún delay artificial — solo es el fondo de ventana.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa 1: Fondo blanco para el logo azul -->
    <item>
        <color android:color="#FFFFFF" />
    </item>

    <!-- Capa 2: Logo oficial centrado, con margen para que no ocupe toda la pantalla -->
    <item
        android:gravity="center"
        android:width="220dp"
        android:height="220dp">
        <bitmap
            android:src="@drawable/ic_logo_stockcalzado"
            android:gravity="center"
            android:tileMode="disabled" />
    </item>

</layer-list>
