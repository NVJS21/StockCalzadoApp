<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.StockCalzadoApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/neon_purple</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/toxic_green</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════
         Splash Screen Theme — se aplica solo al arranque de la app
         Muestra el logo centrado sobre fondo oscuro sin delay artificial
         ══════════════════════════════════════════════════════════ -->
    <style name="Theme.StockCalzadoApp.Splash" parent="Theme.StockCalzadoApp">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Custom Typography Styles -->
    <style name="TextAppearance.StockCalzado.Headline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    
    <!-- Massive Button Style -->
    <style name="Widget.StockCalzado.MassiveButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">24dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- Street Card Style -->
    <style name="Widget.StockCalzado.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">8dp</item>
    </style>
</resources>
