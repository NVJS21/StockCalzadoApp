<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX PreviewView -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay semitransparente con marco de escaneo -->
    <View
        android:id="@+id/scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Marco cuadrado central -->
    <View
        android:id="@+id/scan_frame"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:background="@drawable/scanner_frame_border" />

    <!-- Línea de escaneo animada -->
    <View
        android:id="@+id/scan_line"
        android:layout_width="240dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:background="#FF00FF"
        android:alpha="0.85" />

    <!-- Panel de estado en la parte superior -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESCÁNER DE CÓDIGO DE BARRAS"
            android:textColor="#7B68EE"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tv_scan_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Escaneando..."
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Botón cancelar en la parte inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancelar_escaneo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="CANCELAR"
        android:textColor="#7B68EE"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="#7B68EE"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</FrameLayout>
