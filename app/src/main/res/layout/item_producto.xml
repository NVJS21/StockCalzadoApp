<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/neon_purple"
    app:strokeWidth="1dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Marca + Modelo -->
        <TextView
            android:id="@+id/tv_item_marca_modelo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_item_precio"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Nike Air Max 270" />

        <!-- Precio -->
        <TextView
            android:id="@+id/tv_item_precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/toxic_green"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="150€" />

        <!-- Color + Género -->
        <TextView
            android:id="@+id/tv_item_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_item_precio"
            app:layout_constraintTop_toBottomOf="@id/tv_item_marca_modelo"
            tools:text="Color: Blanco/Negro · Unisex" />

        <!-- Texto Códigos -->
        <TextView
            android:id="@+id/tv_item_codigos_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tallas y códigos en 'Ver tallas'"
            android:textColor="@color/neon_purple"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_item_color" />

        <!-- Imagen del producto -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_producto"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_item_codigos_info"
            tools:src="@android:drawable/ic_menu_gallery" />

        <!-- Divider -->
        <View
            android:id="@+id/divider_item"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/bg_dark_grey"
            app:layout_constraintTop_toBottomOf="@id/iv_producto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stock Almacen label -->
        <TextView
            android:id="@+id/tv_item_stock_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STOCK ALMACÉN"
            android:textColor="@color/street_orange"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_item" />

        <!-- Botón disminuir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disminuir"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="-"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/street_orange"
            app:cornerRadius="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_item_stock_label" />

        <!-- Stock total -->
        <TextView
            android:id="@+id/tv_item_stock_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:gravity="center"
            android:minWidth="64dp"
            app:layout_constraintStart_toEndOf="@id/btn_disminuir"
            app:layout_constraintEnd_toStartOf="@id/btn_aumentar"
            app:layout_constraintTop_toTopOf="@id/btn_disminuir"
            app:layout_constraintBottom_toBottomOf="@id/btn_disminuir"
            tools:text="12" />

        <!-- Botón aumentar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aumentar"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textSize="24sp"
            android:textColor="@color/bg_black"
            app:backgroundTint="@color/toxic_green"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_disminuir"
            app:layout_constraintBottom_toBottomOf="@id/btn_disminuir" />

        <!-- Ver tallas button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_tallas"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:text="VER TALLAS"
            android:textSize="12sp"
            android:textColor="@color/bg_black"
            app:backgroundTint="@color/neon_purple"
            app:cornerRadius="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_disminuir"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
